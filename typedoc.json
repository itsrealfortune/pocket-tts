{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts"],
	"out": "docs",
	"name": "pocket-tts",
	"includeVersion": true,
	"readme": "README.md",
	"blockTags": [
		"@abstract",
		"@alpha",
		"@async",
		"@beta",
		"@decorator",
		"@deprecated",
		"@eventProperty",
		"@example",
		"@experimental",
		"@ignore",
		"@inheritDoc",
		"@internal",
		"@label",
		"@link",
		"@module",
		"@namespace",
		"@override",
		"@packageDocumentation",
		"@param",
		"@privateRemarks",
		"@property",
		"@public",
		"@readonly",
		"@remarks",
		"@returns",
		"@satisfies",
		"@sealed",
		"@see",
		"@since",
		"@throws",
		"@typeParam",
		"@virtual"
	],
	"excludePrivate": true,
	"excludeInternal": true,
	"treatWarningsAsErrors": true,
	"skipErrorChecking": false,
	"gitRevision": "main",
	"validation": {
		"notExported": false,
		"invalidLink": false
	}
}
