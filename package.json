{
	"name": "pocket-tts",
	"version": "1.0.0",
	"license": "MIT",
	"description": "Streaming Pocket TTS for Node.js — cloud mode (Kyutai API, 24 built-in voices) and local mode (ONNX runtime with zero-shot voice cloning).",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itsrealfortune/pocket-tts.git"
	},
	"bugs": {
		"url": "https://github.com/itsrealfortune/pocket-tts/issues"
	},
	"homepage": "https://github.com/itsrealfortune/pocket-tts#readme",
	"keywords": [
		"tts",
		"text-to-speech",
		"speech-synthesis",
		"voice-cloning",
		"pocket-tts",
		"kyutai",
		"streaming",
		"onnx",
		"cpu"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"engines": {
		"node": ">=18.17.0"
	},
	"scripts": {
		"prepack": "npm run build",
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"example:cloud": "tsx examples/cloud.ts",
		"example:local": "tsx examples/local.ts",
		"demo": "tsx demo/server.ts",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"test": "bun test src",
		"build": "tsc --project tsconfig.build.json",
		"generate-doc": "bunx typedoc",
		"publish-doc": "bun generate-doc && git add docs typedoc.json && git commit -m 'docs: update TypeDoc' && git push && bunx gh-pages -d docs",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@eslint/js": "^10.0.1",
		"@hono/node-server": "^2.1.4",
		"@types/bun": "^1.3.12",
		"@types/node": "^26.6.4",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"hono": "^4.11.0",
		"jiti": "^2.6.1",
		"onnxruntime-node": "^1.30.0",
		"tsup": "^8.5.1",
		"tsx": "^4.20.0",
		"typedoc": "^0.28.20",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.58.2"
	},
	"peerDependencies": {
		"onnxruntime-node": ">=1.20.0"
	},
	"peerDependenciesMeta": {
		"onnxruntime-node": {
			"optional": true
		}
	}
}
